# ============================================================================
# 保险条款智能问答助手（RAG_demo）— Git 忽略规则
#
# 说明：data/source/ 下的 PDF 与清洗后文本**属于项目内容**（Dify 入库的数据源），
#      故不忽略；本文件只排除构建产物、运行时数据、本地密钥与临时工作区。
# ============================================================================

# ---------- Java / Maven ----------
backend/target/
target/
*.class
*.jar
*.war
.mvn/timing.properties
*.gz

# ---------- Node / Vite ----------
node_modules/
frontend/dist/
dist/
*.tsbuildinfo

# ---------- 运行时数据：H2 文件库 ----------
# 开发期落盘在 data/ 与 backend/data/ 两处，schema 由 JPA ddl-auto:update 生成，
# 属本地状态而非源码，切勿入库。
*.mv.db
*.lock.db
*.trace.db
*.h2.db

# ---------- 日志与运行时标记 ----------
*.log
logs/
*.pid
backend/backend.pid

# ---------- 本地密钥 ----------
# Dify 的 app-api-key / dataset key 一律用环境变量注入（见 README「运行」一节），
# application.yml 里只留 ${DIFY_APP_API_KEY:} 之类的占位符。
.env
.env.*
!.env.example

# ---------- 临时工作区 ----------
# PDF 解析中间产物（page*.html）与一次性探针脚本，不属于交付内容。
docs/_work/

# ---------- 代理 / 工具工作区 ----------
# Agent 自己的会话记忆，不是项目内容，换机器/换人不该跟着走。
.workbuddy/
.workbuddy/**

# ---------- 本地密钥（兜底） ----------
# 检索参数扫描要用 Dify 的 dataset 级 API key，约定存在仓库外的
# %USERPROFILE%\.dify_dataset_key，绝不能入库。这里再加一道兜底，
# 防止有人图省事把它拷进仓库。
*.dify_dataset_key
*dify_dataset_key*
.eval_secrets/

# ---------- 评测运行产物 ----------
# eval/runs/<tag>/ 是有意提交的：它既是调参证据，也是「判据改了可以不重发请求
# 直接重判」（run_iteration.py --resume）的依据。一次全量评测 15 分钟，
# 有了留档就不必重跑。
#
# 但冒烟测试那种一次性调试跑没有留档价值，忽略掉：
eval/runs/smoke/
# 提示词校验用的临时导出（改完确认用的中间物）
eval/prompts/verify_*.txt

# ---------- IDE ----------
.vscode/
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# ---------- Python（eval/ 与 scripts/） ----------
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---------- 操作系统 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store